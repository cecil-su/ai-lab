{
  "name": "@ai-lab/pi-web-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brave-first web search with credential-free fallback for Pi",
  "license": "MIT",
  "keywords": ["pi-package", "web-search"],
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "files": ["extensions", "src", "README.md", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/live.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
