{
  "name": "agentparty-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AgentParty Tauri desktop workbench",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
