{
  "name": "agentparty-main-service",
  "version": "0.1.0",
  "private": true,
  "description": "AgentParty Rust intranet main service",
  "scripts": {
    "dev": "cargo run",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:intranet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-intranet.ps1",
    "build": "cargo build",
    "build:release": "cargo build --release",
    "smoke:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-e2e.ps1",
    "test": "cargo test",
    "check": "cargo check"
  }
}
